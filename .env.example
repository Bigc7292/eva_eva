# Example environment variables for production or local usage.
# Copy this file to `.env.local` (development) or `.env.production` (production)
# and populate the values. Do NOT commit secrets.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# VAPI Configuration
NEXT_PUBLIC_VAPI_API_URL=https://api.vapi.ai
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your-vapi-assistant-id
NEXT_PUBLIC_VAPI_AGENT_ID=your-vapi-agent-id
NEXT_PUBLIC_VAPI_API_KEY=your-public-vapi-api-key
NEXT_PRIVATE_VAPI_API_KEY=your-private-vapi-api-key
NEXT_PUBLIC_VAPI_ORG_ID=your-vapi-org-id
NEXT_PUBLIC_VAPI_CALLER_ID=+10000000000
NEXT_PUBLIC_VAPI_PHONE_NUMBER_ID=your-phone-number-id

# Application settings
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Port used by Next.js when using `next start` (default: 3000)
PORT=3000
