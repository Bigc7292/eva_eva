# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Retell Configuration
NEXT_PUBLIC_RETELL_API_KEY=your_retell_api_key

# Vapi.ai Configuration
NEXT_PUBLIC_VAPI_API_URL=https://api.vapi.ai
NEXT_PUBLIC_VAPI_API_KEY=your_vapi_api_key
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id

# Twilio Configuration
NEXT_PUBLIC_TWILIO_ACCOUNT_SID=your_twilio_account_sid
NEXT_PUBLIC_TWILIO_AUTH_TOKEN=your_twilio_auth_token
NEXT_PUBLIC_TWILIO_PHONE_NUMBER=your_twilio_phone_number

# VoiceGenie Configuration (Legacy)
NEXT_PUBLIC_VOICEGENIE_API_URL=https://core-saas.voicegenie.ai/api/v1
NEXT_PUBLIC_VOICEGENIE_API_TOKEN=your_voicegenie_api_token
NEXT_PUBLIC_VOICEGENIE_WORKSPACE_ID=your_voicegenie_workspace_id
